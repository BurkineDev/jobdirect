# ============================================================================
# JobDirect — Variables d'environnement
# Copiez ce fichier en « .env.local » et remplissez les valeurs.
# (.env.local est ignoré par git — ne jamais committer de vraies clés.)
#
# Architecture : l'application n'utilise QUE la clé publique. La sécurité
# repose sur la RLS Supabase (voir supabase/schema.sql). Aucune clé secrète
# « service role » n'est requise.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Dashboard Supabase > Project Settings > Data API (URL)
#                     > Project Settings > API Keys (clé publique / anon)

# URL du projet — ex : https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » (ou « publishable ») — sûre à exposer côté client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Administration ---------------------------------------------------------
# Courriels autorisés à accéder à /admin (séparés par des virgules).
# Chaque admin doit AUSSI exister dans Supabase Auth et dans la table
# public.admins (voir README).
ADMIN_EMAILS=admin@jobdirect.ca

# --- Paiements Stripe (OPTIONNEL) -------------------------------------------
# Sans ces variables, l'application fonctionne exactement comme avant :
# encaissement manuel par virement Interac. Dès qu'elles sont remplies, le
# paiement par carte s'active (frais de mise en relation + liens de commission).
#
# Dashboard Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY=

# Dashboard Stripe > Développeurs > Webhooks > votre endpoint > « Signing secret »
# Endpoint à créer : https://<votre-domaine>/api/stripe/webhook
# Événements : checkout.session.completed,
#              checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Montant des frais de mise en relation, en dollars (défaut : 24).
CONNECTION_FEE_CAD=24

# URL publique du site, utilisée pour les retours Stripe.
# Inutile sur Vercel (déduite automatiquement) ; requise en local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase : clé service role (REQUISE UNIQUEMENT POUR STRIPE) -----------
# Un webhook Stripe arrive sans session utilisateur : aucune politique RLS ne
# peut l'autoriser. Cette clé est le seul moyen d'écrire l'encaissement.
# ⚠️ SECRÈTE : jamais de préfixe NEXT_PUBLIC_, jamais côté navigateur.
# Dashboard Supabase > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=
